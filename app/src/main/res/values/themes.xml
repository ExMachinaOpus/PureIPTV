<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="pure_background">#FF0E0F13</color>
    <color name="pure_primary">#FF8AB4FF</color>

    <style name="Theme.PureIPTV" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/pure_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <style name="Theme.PureIPTV.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/pure_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.PureIPTV</item>
    </style>
</resources>
