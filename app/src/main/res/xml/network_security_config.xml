<?xml version="1.0" encoding="utf-8"?>
<!--
    Deliberate: most IPTV servers, playlists and EPG hosts are plain http:// and the user chooses
    them. Blocking cleartext would make the app fail with most providers.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
