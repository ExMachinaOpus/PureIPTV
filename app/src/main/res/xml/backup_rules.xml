<?xml version="1.0" encoding="utf-8"?>
<!--
    Backup rules for Android 11 and lower (fullBackupContent). Same policy as
    data_extraction_rules.xml: only user.db is included, so content.db and credentials are left out.
    Keep both in sync.
-->
<full-backup-content>
    <include domain="database" path="user.db" />
    <include domain="database" path="user.db-wal" />
    <include domain="database" path="user.db-shm" />
</full-backup-content>
